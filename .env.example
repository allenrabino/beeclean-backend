# Copy to .env and fill in values. .env is gitignored — never commit it.
#
# Boot validation: src/config/index.ts → validateConfig()
# Required vars must be set or the server throws on startup.

# ── Server (src/config/index.ts, src/index.ts) ──────────────────────────────

PORT=3001
NODE_ENV=development

# ── Auth (src/config/index.ts) — REQUIRED ───────────────────────────────────

# Long random string for signing session JWTs
JWT_SECRET=

# ── Google OAuth (src/config/index.ts, src/services/google.service.ts) — REQUIRED

# Web OAuth client ID (Google Cloud Console)
GOOGLE_CLIENT_ID=
# iOS OAuth client ID — required for iOS idToken audience verification
GOOGLE_IOS_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# ── Supabase (src/config/index.ts, src/services/supabase.service.ts) — REQUIRED

# Local dev: run `supabase start` in apps/backend, copy URL + service_role key
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional ────────────────────────────────────────────────────────────────

# Phone carrier lookup via apilayer numverify (src/services/contacts/lookup.ts)
# If unset, phone lookup returns validation-only (no carrier/type data)
# NUMVERIFY_API_KEY=

# Apple StoreKit promotional offer signing (src/controllers/subscriptions.controller.ts)
# Contents of the .p8 private key PEM; endpoint returns 500 if unset when called
# APPLE_PROMO_PRIVATE_KEY=

# Railway deployment (src/index.ts) — set automatically on Railway
# When present, server binds 0.0.0.0 instead of localhost
# RAILWAY_ENVIRONMENT=
